{
  "manifest_version": 3,
  "name": "Life tracker : Twitch",
  "description": "Mesure le temps passé à regarder Twitch et l'envoie à mon Life tracker, sur mon NAS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch@life-tracker.clegirar",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://clips.twitch.tv/*"
  ],
  "optional_host_permissions": [
    "https://*.ts.net/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Life tracker : Twitch",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
