{
  "name": "life-tracker-twitch-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "test": "tsc -p tsconfig.json && TZ=Europe/Paris node --test 'build/test/*.test.js'",
    "lint": "web-ext lint --source-dir dist --warnings-as-errors"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "web-ext": "10.8.0"
  }
}
