# Mots de passe de développement uniquement. Copier en .env (ignoré par git).
# En production, ils vivent dans le fichier de configuration du NAS, jamais dans le dépôt.
POSTGRES_PASSWORD=dev-superuser
TRACKER_OWNER_PASSWORD=dev-owner
TRACKER_APP_PASSWORD=dev-app
TRACKER_ADMIN_PASSWORD=dev-admin

# Une URL par commande du backend, chacune avec son rôle. En production, `serve` ne reçoit que la sienne.
DATABASE_URL=postgres://tracker_app:dev-app@127.0.0.1:54329/tracker
MIGRATE_DATABASE_URL=postgres://tracker_owner:dev-owner@127.0.0.1:54329/tracker
ADMIN_DATABASE_URL=postgres://tracker_admin:dev-admin@127.0.0.1:54329/tracker
LISTEN_ADDR=127.0.0.1:8080

# Développement seulement, jamais en production : retire Secure du cookie de session (Safari, téléphone en http).
# DEV_INSECURE_COOKIE=true

# Collecteur (`cargo run -- collect`), à décommenter avec une clé et une source de développement :
# Last.fm, Garmin, ou les deux. Pas de clé Garmin en développement : il n'y en a qu'une, celle du NAS ;
# GARMIN_API_URL vise alors un faux serveur.
# LASTFM_API_KEY=
# LASTFM_USER=
# COLLECTOR_TOKEN=
# GARMIN_API_KEY=
# GARMIN_TOKEN=
# GARMIN_API_URL=http://127.0.0.1:9999
# INGEST_URL=http://127.0.0.1:8080
# COLLECTOR_STATE_DIR=/tmp/life-tracker-collector
