# Production : copier en .env à côté de compose.yaml, sur le NAS. Aucun secret dans ce fichier.
COMPOSE_PROJECT_NAME=life-tracker
# OWNER en minuscules, comme ghcr.io l'exige.
TRACKER_IMAGE_PREFIX=ghcr.io/OWNER/life-tracker
# SHA complet du commit construit par GitHub Actions. Jamais latest.
TRACKER_TAG=COMMIT_SHA
# Adresse et port du seul service publié. 127.0.0.1 : uniquement `tailscale serve`, sur le NAS.
TRACKER_BIND_ADDR=127.0.0.1
TRACKER_HTTP_PORT=18080

# Les secrets vivent dans secrets/, un fichier par service (commandes dans docs/deploiement.md).
# Modèle, mots de passe en hexadécimal pour rester valides dans une URL :
#
# secrets/db.env
#   POSTGRES_PASSWORD=CHANGE_ME
#   TRACKER_OWNER_PASSWORD=CHANGE_ME_OWNER
#   TRACKER_APP_PASSWORD=CHANGE_ME_APP
#   TRACKER_ADMIN_PASSWORD=CHANGE_ME_ADMIN
# secrets/migrate.env
#   MIGRATE_DATABASE_URL=postgres://tracker_owner:CHANGE_ME_OWNER@db:5432/tracker
# secrets/backend.env
#   DATABASE_URL=postgres://tracker_app:CHANGE_ME_APP@db:5432/tracker
# secrets/admin.env
#   ADMIN_DATABASE_URL=postgres://tracker_admin:CHANGE_ME_ADMIN@db:5432/tracker
