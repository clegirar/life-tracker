# Production : copier en .env à côté de compose.yaml, sur le NAS. Aucun secret dans ce fichier.
COMPOSE_PROJECT_NAME=life-tracker
# OWNER en minuscules, comme ghcr.io l'exige.
TRACKER_IMAGE_PREFIX=ghcr.io/OWNER/life-tracker
# Tag de la release construite par GitHub Actions, réécrit par deploy/deploy.sh. Jamais latest.
TRACKER_TAG=vX.Y.Z
# Adresse et port du seul service publié. 127.0.0.1 : uniquement `tailscale serve`, sur le NAS.
TRACKER_BIND_ADDR=127.0.0.1
TRACKER_HTTP_PORT=18080
# Le serveur MCP : l'origine publique de Tailscale Funnel (port 8443), sans chemin. Le connecteur de
# Claude est cette adresse suivie de /mcp. Le port publié, sur 127.0.0.1 seulement, reçoit Funnel.
MCP_PUBLIC_URL=https://NAS.TAILNET.ts.net:8443
MCP_HTTP_PORT=18443

# Les secrets vivent dans secrets/, un fichier par service (commandes dans docs/deploiement.md).
# Modèle, mots de passe en hexadécimal pour rester valides dans une URL :
#
# secrets/db.env
#   POSTGRES_PASSWORD=CHANGE_ME
#   TRACKER_OWNER_PASSWORD=CHANGE_ME_OWNER
#   TRACKER_APP_PASSWORD=CHANGE_ME_APP
#   TRACKER_ADMIN_PASSWORD=CHANGE_ME_ADMIN
# secrets/migrate.env
#   MIGRATE_DATABASE_URL=postgres://tracker_owner:CHANGE_ME_OWNER@db:5432/tracker
# secrets/backend.env
#   DATABASE_URL=postgres://tracker_app:CHANGE_ME_APP@db:5432/tracker
# secrets/admin.env
#   ADMIN_DATABASE_URL=postgres://tracker_admin:CHANGE_ME_ADMIN@db:5432/tracker
# secrets/collector.env : la clé Last.fm et le token de la source, lus par le seul collecteur.
#   LASTFM_API_KEY=CHANGE_ME_LASTFM_KEY
#   LASTFM_USER=CHANGE_ME_LASTFM_USER
#   COLLECTOR_TOKEN=CHANGE_ME_TOKEN_DE_LA_SOURCE_LASTFM
# secrets/mcp.env : le jeton de service (admin create-service-token mcp) et le haché du secret de
# connexion (hash-password de l'image mcp, déjà encodé), lus par le seul serveur MCP.
#   MCP_SERVICE_TOKEN=CHANGE_ME_JETON_DE_SERVICE
#   MCP_LOGIN_HASH=CHANGE_ME_SORTIE_DE_HASH_PASSWORD
